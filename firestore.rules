rules_version = '2';

// MediStock Cloud — multi-shop roles & security (v16)
// v16 (dispensing permission fix): reading a document that does not exist yet was DENIED for everyone, owner included, on prescriptions and
//   dispense_records (the read rules looked at resource.data, which is null for a missing document). The dispensing transaction must read the
//   first dispense record and the prescription BEFORE they exist (duplicate check), so every dispensing failed with permission-denied.
//   Fix: single-document reads of a MISSING document are allowed for the owner or an operator with dispense.perform; reads of existing
//   documents and all list queries are unchanged. Also: users with dispense.view can read MEDICINE orders, patient registration numbers
//   and allergies of their own facility (they needed patient.view before). Everything else is UNCHANGED from v15.
// v15 (Phase 5): adds prescriptions, dispense_records (append-only) and guidelines rules at the end; stock_transactions entries of type
//   DISPENSE can no longer be changed or deleted, and can only be created together with their dispense record. Everything else is UNCHANGED from v14.
// v14: adds Phase 4 (treatment plans, orders, planned administrations, medication record) rules at the end.
// v13: adds Phase 3 (investigations and diagnoses) rules at the end.
// v12: adds Phase 2 (encounters, triage, consultation) rules at the end of the Patient Care section.
// v10: Patient Care (pc_*) rules. v11: patients are visible only to the facility that registered them;
// sharing a patient with another facility (same business or another business) uses pc_shares;
// pc_directory lists facilities (with services) that owners choose to publish.
// Everything above the PATIENT CARE section is UNCHANGED from v9.
// v9: operators can only reach shops of THEIR OWN business; drug classes, dosage forms and
// expense categories are now per business (businesses/{id}/...) instead of one shared global list.
// v8 change: operator accounts can only be created from an owner's invite (see /invites below),
// and owner profiles only for the person the business names as its owner. Nobody can simply
// create a profile that claims to belong to someone else's business.
//   - owner: full access to every shop in their business
//   - operator: full access to exactly the one shop they're assigned to (while active)

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwnerOfBusiness(businessId) {
      return isSignedIn()
        && myProfile().role == 'owner'
        && myProfile().businessId == businessId;
    }

    function isActiveOperatorOfShop(shopId) {
      return isSignedIn()
        && myProfile().role == 'operator'
        && myProfile().active == true
        && myProfile().shopId == shopId;
    }

    function canAccessShop(businessId, shopId) {
      return isOwnerOfBusiness(businessId)
        || (isActiveOperatorOfShop(shopId) && myProfile().businessId == businessId);
    }

    function isMemberOfBusiness(businessId) {
      return isOwnerOfBusiness(businessId)
        || (isSignedIn() && myProfile().role == 'operator'
            && myProfile().active == true && myProfile().businessId == businessId);
    }

    function shopScoped() {
      return canAccessShop(resource.data.businessId, resource.data.shopId);
    }
    function shopScopedCreate() {
      return canAccessShop(request.resource.data.businessId, request.resource.data.shopId);
    }

    // ---- Invites (new in v8) ----
    // The owner writes one invite per new operator (id = shopId_operatorId). The operator's own
    // profile may only be created if a matching, still-unused invite exists.
    function invitePath(d) {
      return /databases/$(database)/documents/invites/$(d.shopId + '_' + d.operatorId);
    }
    function validInviteFor(d) {
      return exists(invitePath(d))
        && get(invitePath(d)).data.used == false
        && get(invitePath(d)).data.businessId == d.businessId
        && get(invitePath(d)).data.shopId == d.shopId
        && get(invitePath(d)).data.operatorId == d.operatorId
        && get(invitePath(d)).data.name == d.name;
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && isOwnerOfBusiness(resource.data.businessId);
      allow create: if isSignedIn()
        && isOwnerOfBusiness(request.resource.data.businessId)
        && request.resource.data.used == false;
      allow update: if isSignedIn() && resource.data.used == false && (
        // the owner re-saving an invite that hasn't been used yet
        (isOwnerOfBusiness(resource.data.businessId) && request.resource.data.used == false)
        ||
        // the new operator claiming it, and changing nothing else
        (request.resource.data.used == true
          && request.resource.data.usedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt']))
      );
      allow delete: if false;
    }

    // ---- Accounts ----

    match /users/{uid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || isOwnerOfBusiness(resource.data.businessId));
      // Owner signing up: the business document (created one step earlier) must name this person as owner.
      // Operator: must match an unused invite written by that business's owner.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.businessId is string
        && request.resource.data.role in ['owner', 'operator']
        && (
          (request.resource.data.role == 'owner'
            && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerUid == request.auth.uid)
          ||
          (request.resource.data.role == 'operator'
            && request.resource.data.active == true
            && validInviteFor(request.resource.data))
        );
      allow update: if isSignedIn() && isOwnerOfBusiness(resource.data.businessId);
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow read: if isOwnerOfBusiness(businessId) ||
        (isSignedIn() && myProfile().role == 'operator' && myProfile().active == true
          && myProfile().businessId == businessId);
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isOwnerOfBusiness(businessId);
      allow delete: if false;
    }

    match /shops/{shopId} {
      allow read: if canAccessShop(resource.data.businessId, shopId);
      allow create: if isOwnerOfBusiness(request.resource.data.businessId);
      allow update: if isOwnerOfBusiness(resource.data.businessId);
      allow delete: if false;
    }

    // ---- Shop-scoped business data (unchanged) ----

    match /drugs/{docId}                 { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    match /batches/{docId}                { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    match /sales/{docId}                  { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    match /purchases/{docId}              { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    match /suppliers/{docId}              { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    match /supplier_transactions/{docId}  { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    // v15: DISPENSE entries are written only by the dispensing transaction and are then permanent. Every other type behaves exactly as before.
    match /stock_transactions/{docId} {
      allow read: if shopScoped();
      allow update: if shopScoped()
        && resource.data.get('type', '') != 'DISPENSE' && request.resource.data.get('type', '') != 'DISPENSE';
      allow delete: if shopScoped() && resource.data.get('type', '') != 'DISPENSE';
      allow create: if shopScopedCreate()
        && (request.resource.data.get('type', '') != 'DISPENSE'
            || (hasPerm(request.resource.data.businessId, 'dispense.perform')
                && request.resource.data.baseUnitsChange is number && request.resource.data.baseUnitsChange < 0
                && request.resource.data.dispenseRequestId is string
                && docId.matches('dsp_' + request.resource.data.dispenseRequestId + '_[0-9]+')
                && existsAfter(/databases/$(database)/documents/dispense_records/$(request.resource.data.dispenseRequestId + '_0'))));
    }
    match /stock_adjustments/{docId}      { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    match /counters/{docId} {
      allow read: if isSignedIn() && (resource == null || shopScoped());
      allow update: if shopScoped();
      allow create: if shopScopedCreate();
      allow delete: if false;
    }
    match /expenses/{docId}               { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    match /receipts/{docId}               { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    // Cash adjustments: anyone in the shop can add one, but it must carry a reason and the id of the person
    // adding it; once saved, only the owner can change or remove it (so the "who" cannot be rewritten).
    match /cash_adjustments/{docId} {
      allow read: if shopScoped();
      allow create: if shopScopedCreate()
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 3;
      allow update, delete: if isOwnerOfBusiness(resource.data.businessId);
    }
    match /credit_accounts/{docId}        { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }
    match /credit_transactions/{docId}    { allow read, update, delete: if shopScoped(); allow create: if shopScopedCreate(); }

    match /audit_log/{docId} {
      allow read: if shopScoped();
      allow create: if shopScopedCreate();
      allow update, delete: if false;
    }

    // ---- Reference data, per business (v9) ----
    match /businesses/{businessId}/drug_classes/{name} {
      allow read: if isMemberOfBusiness(businessId);
      allow create: if isMemberOfBusiness(businessId)
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name == name && name.size() > 0 && name.size() < 60;
      allow update: if isMemberOfBusiness(businessId) && request.resource.data == resource.data;
      allow delete: if isOwnerOfBusiness(businessId);
    }
    match /businesses/{businessId}/dosage_forms/{name} {
      allow read: if isMemberOfBusiness(businessId);
      allow create: if isMemberOfBusiness(businessId)
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name == name && name.size() > 0 && name.size() < 60;
      allow update: if isMemberOfBusiness(businessId) && request.resource.data == resource.data;
      allow delete: if isOwnerOfBusiness(businessId);
    }
    match /businesses/{businessId}/expense_categories/{name} {
      allow read: if isMemberOfBusiness(businessId);
      allow create: if isMemberOfBusiness(businessId)
        && request.resource.data.keys().hasOnly(['name'])
        && request.resource.data.name == name && name.size() > 0 && name.size() < 60;
      allow update: if isMemberOfBusiness(businessId) && request.resource.data == resource.data;
      allow delete: if isOwnerOfBusiness(businessId);
    }

    // =====================================================================================
    // PATIENT CARE (Phase 1a) — new in v10. Collections are prefixed pc_ . Nothing here touches
    // the shop data rules above. Clinical records can never be deleted; corrections are new
    // documents or status-only changes. Permissions come from users/{uid}.perms (owner = all).
    // =====================================================================================

    function hasPerm(businessId, perm) {
      return isOwnerOfBusiness(businessId)
        || (isSignedIn() && myProfile().role == 'operator' && myProfile().active == true
            && myProfile().businessId == businessId
            && myProfile().get('perms', {}).get(perm, false) == true);
    }

    function shopDoc(shopId) {
      return get(/databases/$(database)/documents/shops/$(shopId)).data;
    }

    // the facility belongs to this business AND has Patient Care switched on
    function pcFacilityOk(businessId, facilityId) {
      return exists(/databases/$(database)/documents/shops/$(facilityId))
        && shopDoc(facilityId).businessId == businessId
        && shopDoc(facilityId).get('enabledServices', []).hasAny(['patient_care']);
    }

    function patientPath(patientId) {
      return /databases/$(database)/documents/pc_patients/$(patientId);
    }
    function patientInBusiness(patientId, businessId) {
      return exists(patientPath(patientId)) && get(patientPath(patientId)).data.businessId == businessId;
    }

    // common checks for creating any pc_ record
    function pcCreateOk(d) {
      return d.businessId is string && d.facilityId is string
        && canAccessShop(d.businessId, d.facilityId)
        && pcFacilityOk(d.businessId, d.facilityId)
        && d.createdBy == request.auth.uid
        && d.createdAt == request.time
        && d.schemaVersion is int;
    }

    // fields that may never change on an existing pc_ record
    function pcLocked() {
      return ['businessId', 'facilityId', 'patientId', 'createdBy', 'createdAt'];
    }
    function pcUpdateStamped() {
      return request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
    }

    // ---- Patient identity (shared inside one business) ----
    match /pc_patients/{patientId} {
      // only the facility that registered the patient (or the owner) can read it; other facilities get a share (pc_shares)
      allow read: if hasPerm(resource.data.businessId, 'patient.view')
        && (isOwnerOfBusiness(resource.data.businessId)
            || canAccessShop(resource.data.businessId, resource.data.registeredFacilityId));

      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'patient.register')
        && request.resource.data.registeredFacilityId == request.resource.data.facilityId
        && request.resource.data.status == 'active'
        && request.resource.data.fullName is string && request.resource.data.fullName.size() >= 2
        && request.resource.data.sex in ['male', 'female', 'other', 'unknown']
        && !('mergedInto' in request.resource.data);

      allow update: if (
          // ordinary edit of an active patient, by the registering facility (or owner)
          hasPerm(resource.data.businessId, 'patient.edit')
          && canAccessShop(resource.data.businessId, resource.data.registeredFacilityId)
          && resource.data.status == 'active'
          && request.resource.data.status == 'active'
          && !request.resource.data.diff(resource.data).affectedKeys()
               .hasAny(pcLocked().concat(['registeredFacilityId', 'status', 'mergedInto']))
          && pcUpdateStamped()
        ) || (
          // merge: only together with a merge record whose id is this patient's id
          hasPerm(resource.data.businessId, 'patient.merge')
          && resource.data.status == 'active'
          && request.resource.data.status == 'merged'
          && request.resource.data.mergedInto is string
          && request.resource.data.mergedInto != patientId
          && patientInBusiness(request.resource.data.mergedInto, resource.data.businessId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'mergedInto', 'updatedAt', 'updatedBy'])
          && pcUpdateStamped()
          && existsAfter(/databases/$(database)/documents/pc_patient_merges/$(patientId))
          && getAfter(/databases/$(database)/documents/pc_patient_merges/$(patientId)).data.survivorId
               == request.resource.data.mergedInto
        );
      allow delete: if false;
    }

    // ---- Which facility has registered the patient (id = patientId_facilityId, so no duplicates) ----
    match /pc_patient_facility_links/{linkId} {
      allow read: if (hasPerm(resource.data.businessId, 'patient.view') || hasPerm(resource.data.businessId, 'dispense.view'))
        && canAccessShop(resource.data.businessId, resource.data.facilityId);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'patient.register')
        && linkId == request.resource.data.patientId + '_' + request.resource.data.facilityId
        && patientInBusiness(request.resource.data.patientId, request.resource.data.businessId)
        && request.resource.data.localRegNo is string && request.resource.data.localRegNo.size() > 0
        && request.resource.data.status == 'active';
      allow update: if hasPerm(resource.data.businessId, 'patient.edit')
        && canAccessShop(resource.data.businessId, resource.data.facilityId)
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(pcLocked().concat(['localRegNo', 'registeredAt', 'registeredBy']))
        && pcUpdateStamped();
      allow delete: if false;
    }

    // ---- Sharing a patient with another facility (same business or another business) ----
    // id = patientId_sourceFacilityId_granteeBusinessId. The share carries a snapshot of who the patient is;
    // allergies and history are then read live from the source facility while the share is not stopped.
    function sharePath(patientId, sourceFacilityId, granteeBusinessId) {
      return /databases/$(database)/documents/pc_shares/$(patientId + '_' + sourceFacilityId + '_' + granteeBusinessId);
    }
    function shareOkForMe(patientId, sourceFacilityId) {
      return isSignedIn()
        && hasPerm(myProfile().businessId, 'patient.view')
        && exists(sharePath(patientId, sourceFacilityId, myProfile().businessId))
        && get(sharePath(patientId, sourceFacilityId, myProfile().businessId)).data.get('revokedAt', null) == null
        && (myProfile().role == 'owner'
            || get(sharePath(patientId, sourceFacilityId, myProfile().businessId)).data.granteeFacilityId == myProfile().shopId);
    }
    // the receiving facility is either one of this business's own shops with Patient Care on, or a facility listed in the directory
    function granteeOk(d) {
      return (d.granteeBusinessId == d.businessId
              && exists(/databases/$(database)/documents/shops/$(d.granteeFacilityId))
              && shopDoc(d.granteeFacilityId).businessId == d.businessId
              && shopDoc(d.granteeFacilityId).get('enabledServices', []).hasAny(['patient_care']))
        || (exists(/databases/$(database)/documents/pc_directory/$(d.granteeFacilityId))
              && get(/databases/$(database)/documents/pc_directory/$(d.granteeFacilityId)).data.businessId == d.granteeBusinessId
              && get(/databases/$(database)/documents/pc_directory/$(d.granteeFacilityId)).data.get('listed', false) == true
              && exists(/databases/$(database)/documents/shops/$(d.granteeFacilityId))
              && shopDoc(d.granteeFacilityId).businessId == d.granteeBusinessId
              && shopDoc(d.granteeFacilityId).get('enabledServices', []).hasAny(['patient_care']));
    }
    function shareFieldsOk(d) {
      return d.purpose is string && d.purpose.size() >= 3
        && d.consentGivenBy is string && d.consentGivenBy.size() >= 2
        && d.consentMethod in ['verbal', 'written']
        && d.patientSnapshot is map
        && d.granteeFacilityId is string && d.granteeBusinessId is string
        && !(d.granteeBusinessId == d.businessId && d.granteeFacilityId == d.facilityId)
        && granteeOk(d);
    }

    match /pc_shares/{shareId} {
      allow read: if (canAccessShop(resource.data.businessId, resource.data.facilityId)
                      && hasPerm(resource.data.businessId, 'patient.consent'))
        || isOwnerOfBusiness(resource.data.granteeBusinessId)
        || (isSignedIn() && myProfile().role == 'operator' && myProfile().active == true
            && myProfile().businessId == resource.data.granteeBusinessId
            && myProfile().shopId == resource.data.granteeFacilityId
            && myProfile().get('perms', {}).get('patient.view', false) == true);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'patient.consent')
        && shareId == request.resource.data.patientId + '_' + request.resource.data.facilityId + '_' + request.resource.data.granteeBusinessId
        && patientInBusiness(request.resource.data.patientId, request.resource.data.businessId)
        && get(patientPath(request.resource.data.patientId)).data.registeredFacilityId == request.resource.data.facilityId
        && request.resource.data.grantedBy == request.auth.uid
        && request.resource.data.get('revokedAt', null) == null
        && shareFieldsOk(request.resource.data);
      allow update: if hasPerm(resource.data.businessId, 'patient.consent')
        && canAccessShop(resource.data.businessId, resource.data.facilityId)
        && pcUpdateStamped()
        && (
          // stop sharing
          (resource.data.get('revokedAt', null) == null
            && request.resource.data.revokedAt != null
            && request.resource.data.revokedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['revokedAt', 'revokedBy', 'updatedAt', 'updatedBy']))
          ||
          // share again (can pick another facility of the same receiving business; the patient snapshot is refreshed)
          (resource.data.get('revokedAt', null) != null
            && request.resource.data.get('revokedAt', null) == null
            && request.resource.data.grantedBy == request.auth.uid
            && shareFieldsOk(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['revokedAt', 'revokedBy', 'grantedAt', 'grantedBy', 'purpose', 'consentMethod', 'consentGivenBy',
                           'granteeFacilityId', 'granteeFacilityName', 'patientSnapshot', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    // ---- Facility directory: facilities the owner chooses to publish (name, services, description). No patient data. ----
    match /pc_directory/{facilityId} {
      allow read: if isSignedIn() && myProfile().active == true;
      allow create: if isOwnerOfBusiness(request.resource.data.businessId)
        && exists(/databases/$(database)/documents/shops/$(facilityId))
        && shopDoc(facilityId).businessId == request.resource.data.businessId
        && request.resource.data.facilityId == facilityId
        && request.resource.data.facilityName is string && request.resource.data.facilityName.size() > 0
        && request.resource.data.businessName is string && request.resource.data.businessName.size() > 0
        && request.resource.data.services is list
        && request.resource.data.listed is bool;
      allow update: if isOwnerOfBusiness(resource.data.businessId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.facilityId == facilityId
        && request.resource.data.facilityName is string && request.resource.data.facilityName.size() > 0
        && request.resource.data.businessName is string && request.resource.data.businessName.size() > 0
        && request.resource.data.services is list
        && request.resource.data.listed is bool;
      allow delete: if false;
    }

    // ---- Allergies (facility-scoped; shared only through a live consent) ----
    match /pc_allergies/{docId} {
      allow read: if (canAccessShop(resource.data.businessId, resource.data.facilityId)
                      && (hasPerm(resource.data.businessId, 'patient.view') || hasPerm(resource.data.businessId, 'dispense.view')))
        || shareOkForMe(resource.data.patientId, resource.data.facilityId);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'allergy.record')
        && patientInBusiness(request.resource.data.patientId, request.resource.data.businessId)
        && request.resource.data.substance is string && request.resource.data.substance.size() > 0
        && request.resource.data.severity in ['mild', 'moderate', 'severe', 'unknown']
        && request.resource.data.status == 'active'
        && request.resource.data.recordedBy == request.auth.uid;
      // only way to "remove" an entry: mark it entered in error, with a reason
      allow update: if hasPerm(resource.data.businessId, 'allergy.record')
        && canAccessShop(resource.data.businessId, resource.data.facilityId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'entered_in_error'
        && request.resource.data.errorReason is string && request.resource.data.errorReason.size() >= 3
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'errorReason', 'updatedAt', 'updatedBy'])
        && pcUpdateStamped();
      allow delete: if false;
    }

    // ---- Medical history entries (same pattern; edits are new documents using `supersedes`) ----
    match /pc_medical_history/{docId} {
      allow read: if (canAccessShop(resource.data.businessId, resource.data.facilityId)
                      && hasPerm(resource.data.businessId, 'patient.view'))
        || shareOkForMe(resource.data.patientId, resource.data.facilityId);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'history.record')
        && patientInBusiness(request.resource.data.patientId, request.resource.data.businessId)
        && request.resource.data.type in ['chronic_illness', 'previous_diagnosis', 'admission', 'operation',
             'current_medicine', 'previous_medicine', 'family_history', 'social_history', 'pregnancy_breastfeeding']
        && request.resource.data.text is string && request.resource.data.text.size() > 0
        && request.resource.data.status == 'active';
      allow update: if hasPerm(resource.data.businessId, 'history.record')
        && canAccessShop(resource.data.businessId, resource.data.facilityId)
        && resource.data.status == 'active'
        && request.resource.data.status in ['resolved', 'entered_in_error']
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'errorReason', 'updatedAt', 'updatedBy'])
        && (request.resource.data.status == 'resolved'
            || (request.resource.data.errorReason is string && request.resource.data.errorReason.size() >= 3))
        && pcUpdateStamped();
      allow delete: if false;
    }

    // ---- Merge records (id = the id of the patient being merged away) ----
    match /pc_patient_merges/{mergedPatientId} {
      allow read: if hasPerm(resource.data.businessId, 'patient.merge');
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'patient.merge')
        && request.resource.data.mergedId == mergedPatientId
        && request.resource.data.survivorId is string
        && request.resource.data.survivorId != mergedPatientId
        && patientInBusiness(mergedPatientId, request.resource.data.businessId)
        && patientInBusiness(request.resource.data.survivorId, request.resource.data.businessId)
        && get(patientPath(mergedPatientId)).data.status == 'active'
        && get(patientPath(request.resource.data.survivorId)).data.status == 'active'
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 5
        && request.resource.data.mergedBy == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Audit and access logs: add-only. Rules cannot force the app to write them (known limit). ----
    match /pc_audit_logs/{docId} {
      allow read: if hasPerm(resource.data.businessId, 'audit.view');
      allow create: if pcCreateOk(request.resource.data)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.action is string;
      allow update, delete: if false;
    }
    match /pc_access_logs/{docId} {
      allow read: if hasPerm(resource.data.businessId, 'audit.view');
      allow create: if pcCreateOk(request.resource.data)
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.purpose is string && request.resource.data.purpose.size() >= 3;
      allow update, delete: if false;
    }

    // =====================================================================================
    // PHASE 2: encounters, triage and consultation (new in v12). Records are facility-only.
    // Clinical entries are add-only: they can be marked "entered in error" but never edited or deleted.
    // A note can be edited only while it is a draft; once signed it can only be amended by a new note.
    // =====================================================================================
    function encPath(id) { return /databases/$(database)/documents/pc_encounters/$(id); }
    function notePath(id) { return /databases/$(database)/documents/pc_clinical_notes/$(id); }
    function encounterOpenOk(d) {
      return d.encounterId is string && exists(encPath(d.encounterId))
        && get(encPath(d.encounterId)).data.status == 'open'
        && get(encPath(d.encounterId)).data.patientId == d.patientId
        && get(encPath(d.encounterId)).data.facilityId == d.facilityId
        && get(encPath(d.encounterId)).data.businessId == d.businessId;
    }
    function numOk(d, key, lo, hi) {
      return !(key in d) || d[key] == null || (d[key] is number && d[key] >= lo && d[key] <= hi);
    }
    function anyEncounterPerm(biz) {
      return hasPerm(biz, 'encounter.open') || hasPerm(biz, 'triage.record') || hasPerm(biz, 'consult.record');
    }
    function childReadOk(d) {
      return canAccessShop(d.businessId, d.facilityId) && hasPerm(d.businessId, 'patient.view');
    }
    function childCreateOk(d, perm) {
      return pcCreateOk(d) && hasPerm(d.businessId, perm) && encounterOpenOk(d)
        && d.recordedBy == request.auth.uid && d.status == 'active';
    }
    function childErrorOk(perm) {
      return hasPerm(resource.data.businessId, perm)
        && canAccessShop(resource.data.businessId, resource.data.facilityId)
        && resource.data.status == 'active'
        && request.resource.data.status == 'entered_in_error'
        && request.resource.data.errorReason is string && request.resource.data.errorReason.size() >= 3
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'errorReason', 'updatedAt', 'updatedBy'])
        && pcUpdateStamped();
    }
    function triageOk(d) {
      return numOk(d, 'temperatureC', 25, 45) && numOk(d, 'bpSys', 20, 300) && numOk(d, 'bpDia', 10, 200)
        && numOk(d, 'pulse', 10, 300) && numOk(d, 'respRate', 2, 100) && numOk(d, 'spo2', 30, 100)
        && numOk(d, 'weightKg', 0.3, 500) && numOk(d, 'heightCm', 20, 260) && numOk(d, 'painScore', 0, 10)
        && numOk(d, 'muacCm', 3, 60) && numOk(d, 'glucose', 0, 1000)
        && (!('consciousness' in d) || d.consciousness == null || d.consciousness in ['alert', 'voice', 'pain', 'unresponsive'])
        && (!('category' in d) || d.category == null || d.category in ['emergency', 'urgent', 'standard', 'low'])
        && (!('glucoseUnit' in d) || d.glucoseUnit == null || d.glucoseUnit in ['mmol/L', 'mg/dL']);
    }

    match /pc_encounters/{encId} {
      allow read: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'patient.view');
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'encounter.open')
        && patientInBusiness(request.resource.data.patientId, request.resource.data.businessId)
        && get(patientPath(request.resource.data.patientId)).data.registeredFacilityId == request.resource.data.facilityId
        && get(patientPath(request.resource.data.patientId)).data.status == 'active'
        && request.resource.data.status == 'open'
        && request.resource.data.type in ['outpatient', 'emergency', 'followup', 'procedure', 'pharmacy']
        && request.resource.data.encounterNo is string && request.resource.data.encounterNo.size() > 0
        && request.resource.data.reason is string
        && request.resource.data.openedBy == request.auth.uid;
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && pcUpdateStamped()
        && resource.data.status == 'open'
        && (
          (anyEncounterPerm(resource.data.businessId)
            && request.resource.data.status == 'open'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stage', 'triageCategory', 'updatedAt', 'updatedBy'])
            && request.resource.data.stage in ['registered', 'triaged', 'in_consultation']
            && (request.resource.data.get('triageCategory', null) == null
                || request.resource.data.triageCategory in ['emergency', 'urgent', 'standard', 'low']))
          ||
          (hasPerm(resource.data.businessId, 'encounter.close')
            && request.resource.data.status in ['closed', 'cancelled']
            && request.resource.data.closedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'closedAt', 'closedBy', 'closeNote', 'cancelReason', 'updatedAt', 'updatedBy'])
            && (request.resource.data.status == 'closed'
                || (request.resource.data.get('cancelReason', null) is string && request.resource.data.cancelReason.size() >= 3)))
        );
      allow delete: if false;
    }

    match /pc_triage/{id} {
      allow read: if childReadOk(resource.data);
      allow create: if childCreateOk(request.resource.data, 'triage.record') && triageOk(request.resource.data);
      allow update: if childErrorOk('triage.record');
      allow delete: if false;
    }

    match /pc_complaints/{id} {
      allow read: if childReadOk(resource.data);
      allow create: if childCreateOk(request.resource.data, 'consult.record')
        && request.resource.data.name is string && request.resource.data.name.size() > 0;
      allow update: if childErrorOk('consult.record');
      allow delete: if false;
    }

    match /pc_prior_medications/{id} {
      allow read: if childReadOk(resource.data);
      allow create: if childCreateOk(request.resource.data, 'consult.record')
        && request.resource.data.medicineName is string && request.resource.data.medicineName.size() > 0;
      allow update: if childErrorOk('consult.record');
      allow delete: if false;
    }

    match /pc_clinical_notes/{noteId} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'consult.record')
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.noteType in ['hpi', 'examination', 'assessment', 'progress', 'other', 'amendment']
        && request.resource.data.content is string && request.resource.data.content.size() > 0
        && (
          (request.resource.data.noteType != 'amendment'
            && encounterOpenOk(request.resource.data)
            && (request.resource.data.status == 'draft'
                || (request.resource.data.status == 'signed'
                    && hasPerm(request.resource.data.businessId, 'consult.sign')
                    && request.resource.data.signedBy == request.auth.uid
                    && request.resource.data.signedAt == request.time)))
          ||
          (request.resource.data.noteType == 'amendment'
            && request.resource.data.status == 'signed'
            && hasPerm(request.resource.data.businessId, 'consult.sign')
            && request.resource.data.signedBy == request.auth.uid
            && request.resource.data.signedAt == request.time
            && request.resource.data.amends is string
            && exists(notePath(request.resource.data.amends))
            && get(notePath(request.resource.data.amends)).data.status == 'signed'
            && get(notePath(request.resource.data.amends)).data.patientId == request.resource.data.patientId
            && get(notePath(request.resource.data.amends)).data.facilityId == request.resource.data.facilityId)
        );
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && pcUpdateStamped()
        && (
          (resource.data.status == 'draft' && request.resource.data.status == 'draft'
            && resource.data.authorId == request.auth.uid
            && hasPerm(resource.data.businessId, 'consult.record')
            && request.resource.data.content is string && request.resource.data.content.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content', 'structured', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status == 'draft' && request.resource.data.status == 'signed'
            && hasPerm(resource.data.businessId, 'consult.sign')
            && request.resource.data.signedBy == request.auth.uid
            && request.resource.data.signedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'signedAt', 'signedBy', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status in ['draft', 'signed'] && request.resource.data.status == 'entered_in_error'
            && hasPerm(resource.data.businessId, 'consult.sign')
            && request.resource.data.errorReason is string && request.resource.data.errorReason.size() >= 3
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'errorReason', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    // Warning ranges a facility's clinician chooses (nothing is built in). id = facility id.
    match /pc_obs_rules/{facilityId} {
      allow read: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'patient.view');
      allow create: if hasPerm(request.resource.data.businessId, 'settings.manage')
        && canAccessShop(request.resource.data.businessId, facilityId)
        && request.resource.data.facilityId == facilityId
        && pcFacilityOk(request.resource.data.businessId, facilityId)
        && request.resource.data.ranges is map
        && request.resource.data.source is string && request.resource.data.source.size() >= 3;
      allow update: if hasPerm(resource.data.businessId, 'settings.manage')
        && canAccessShop(resource.data.businessId, resource.data.facilityId)
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.facilityId == facilityId
        && request.resource.data.ranges is map
        && request.resource.data.source is string && request.resource.data.source.size() >= 3;
      allow delete: if false;
    }

    // =====================================================================================
    // PHASE 3: tests (investigations) and diagnoses (new in v13). Facility-only, add-only.
    // A result is never overwritten: it can be verified, or replaced by a new result that points to the old one.
    // A diagnosis is never overwritten: a change is a new version, and the old version stays on record.
    // =====================================================================================
    function invOrderPath(id) { return /databases/$(database)/documents/pc_inv_orders/$(id); }
    function invResultPath(id) { return /databases/$(database)/documents/pc_inv_results/$(id); }
    function dxPath(id) { return /databases/$(database)/documents/pc_diagnoses/$(id); }
    function catOk(d) {
      return d.name is string && d.name.size() > 0
        && d.category in ['malaria', 'haematology', 'biochemistry', 'urinalysis', 'pregnancy', 'microbiology', 'stool', 'imaging', 'other']
        && d.resultType in ['number', 'text', 'choice']
        && d.active is bool
        && (d.get('price', null) == null || (d.price is number && d.price >= 0))
        && (!(d.get('refMin', null) != null || d.get('refMax', null) != null || d.get('refText', '') != '')
            || (d.get('refSource', '') is string && d.get('refSource', '').size() >= 3));
    }
    function labCancelPerm(biz) { return hasPerm(biz, 'investigation.request') || hasPerm(biz, 'lab.collect'); }

    match /pc_inv_catalogue/{id} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'catalogue.manage')
        && catOk(request.resource.data);
      allow update: if hasPerm(resource.data.businessId, 'catalogue.manage')
        && canAccessShop(resource.data.businessId, resource.data.facilityId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['businessId', 'facilityId', 'createdBy', 'createdAt'])
        && catOk(request.resource.data)
        && pcUpdateStamped();
      allow delete: if false;
    }

    match /pc_inv_orders/{orderId} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'investigation.request')
        && encounterOpenOk(request.resource.data)
        && request.resource.data.status == 'requested'
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.priority in ['routine', 'urgent', 'stat']
        && request.resource.data.resultType in ['number', 'text', 'choice'];
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && pcUpdateStamped()
        && (
          (resource.data.status == 'requested' && request.resource.data.status == 'collected'
            && hasPerm(resource.data.businessId, 'lab.collect')
            && request.resource.data.collectedBy == request.auth.uid
            && request.resource.data.collectedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'collectedAt', 'collectedBy', 'collectedByName', 'sampleId', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status == 'collected' && request.resource.data.status == 'processing'
            && hasPerm(resource.data.businessId, 'lab.process')
            && request.resource.data.processingBy == request.auth.uid
            && request.resource.data.processingAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'processingAt', 'processingBy', 'processingByName', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status == 'processing' && request.resource.data.status == 'resulted'
            && hasPerm(resource.data.businessId, 'lab.result')
            && request.resource.data.currentResultId == orderId
            && request.resource.data.resultedBy == request.auth.uid
            && request.resource.data.resultedAt == request.time
            && existsAfter(invResultPath(orderId))
            && getAfter(invResultPath(orderId)).data.orderId == orderId
            && getAfter(invResultPath(orderId)).data.status == 'unverified'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'resultedAt', 'resultedBy', 'resultedByName', 'currentResultId', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status == 'resulted' && request.resource.data.status == 'verified'
            && hasPerm(resource.data.businessId, 'lab.verify')
            && request.resource.data.verifiedBy == request.auth.uid
            && request.resource.data.verifiedAt == request.time
            && getAfter(invResultPath(resource.data.currentResultId)).data.status == 'verified'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'verifiedAt', 'verifiedBy', 'verifiedByName', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status == 'verified' && request.resource.data.status == 'reviewed'
            && hasPerm(resource.data.businessId, 'investigation.review')
            && request.resource.data.reviewedBy == request.auth.uid
            && request.resource.data.reviewedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'reviewedAt', 'reviewedBy', 'reviewedByName', 'reviewNote', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status in ['resulted', 'verified', 'reviewed'] && request.resource.data.status == 'resulted'
            && hasPerm(resource.data.businessId, 'lab.result')
            && request.resource.data.currentResultId != resource.data.currentResultId
            && request.resource.data.resultedBy == request.auth.uid
            && request.resource.data.resultedAt == request.time
            && existsAfter(invResultPath(request.resource.data.currentResultId))
            && getAfter(invResultPath(request.resource.data.currentResultId)).data.orderId == orderId
            && getAfter(invResultPath(request.resource.data.currentResultId)).data.amends == resource.data.currentResultId
            && getAfter(invResultPath(request.resource.data.currentResultId)).data.status == 'unverified'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'resultedAt', 'resultedBy', 'resultedByName', 'currentResultId', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status in ['requested', 'collected', 'processing'] && request.resource.data.status == 'cancelled'
            && labCancelPerm(resource.data.businessId)
            && request.resource.data.cancelledBy == request.auth.uid
            && request.resource.data.cancelReason is string && request.resource.data.cancelReason.size() >= 3
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'cancelReason', 'cancelledBy', 'cancelledByName', 'cancelledAt', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    match /pc_inv_results/{resultId} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'lab.result')
        && request.resource.data.status == 'unverified'
        && request.resource.data.enteredBy == request.auth.uid
        && request.resource.data.orderId is string
        && request.resource.data.get('value', null) != null
        && exists(invOrderPath(request.resource.data.orderId))
        && get(invOrderPath(request.resource.data.orderId)).data.patientId == request.resource.data.patientId
        && get(invOrderPath(request.resource.data.orderId)).data.facilityId == request.resource.data.facilityId
        && (
          (resultId == request.resource.data.orderId
            && get(invOrderPath(request.resource.data.orderId)).data.status == 'processing')
          ||
          (resultId != request.resource.data.orderId
            && request.resource.data.amends is string
            && get(invOrderPath(request.resource.data.orderId)).data.status in ['resulted', 'verified', 'reviewed']
            && get(invOrderPath(request.resource.data.orderId)).data.currentResultId == request.resource.data.amends)
        );
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && pcUpdateStamped()
        && (
          (resource.data.status == 'unverified' && request.resource.data.status == 'verified'
            && hasPerm(resource.data.businessId, 'lab.verify')
            && request.resource.data.verifiedBy == request.auth.uid
            && request.resource.data.verifiedAt == request.time
            && getAfter(invOrderPath(resource.data.orderId)).data.status == 'verified'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'verifiedAt', 'verifiedBy', 'verifiedByName', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status in ['unverified', 'verified'] && request.resource.data.status == 'entered_in_error'
            && hasPerm(resource.data.businessId, 'lab.verify')
            && request.resource.data.errorReason is string && request.resource.data.errorReason.size() >= 3
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'errorReason', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    match /pc_diagnoses/{dxId} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'diagnosis.record')
        && encounterOpenOk(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.role in ['primary', 'secondary']
        && request.resource.data.certainty in ['confirmed', 'provisional', 'suspected']
        && request.resource.data.version is int
        && (request.resource.data.get('icd10', null) == null
            || (request.resource.data.icd10 is string && request.resource.data.icd10.matches('^[A-Z][0-9]{2}(\\.[0-9A-Z]{1,4})?$')));
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'diagnosis.record')
        && pcUpdateStamped()
        && resource.data.status == 'active'
        && (
          (request.resource.data.status == 'superseded'
            && request.resource.data.supersededBy is string
            && existsAfter(dxPath(request.resource.data.supersededBy))
            && getAfter(dxPath(request.resource.data.supersededBy)).data.supersedes == dxId
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'supersededBy', 'updatedAt', 'updatedBy']))
          ||
          (request.resource.data.status == 'entered_in_error'
            && request.resource.data.errorReason is string && request.resource.data.errorReason.size() >= 3
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'errorReason', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    // =====================================================================================
    // PHASE 4: treatment plans, medicine and procedure orders, planned administrations, and the
    // medication administration record (new in v14). Facility-only, add-only.
    // Planned administrations are made once and never duplicated. An administration can be recorded once;
    // a wrong record is marked in error and the planned administration goes back to pending.
    // =====================================================================================
    function planPath(id) { return /databases/$(database)/documents/pc_treatment_plans/$(id); }
    function ordPath(id) { return /databases/$(database)/documents/pc_treatment_orders/$(id); }
    function evPath(id) { return /databases/$(database)/documents/pc_treatment_events/$(id); }
    function marPath(id) { return /databases/$(database)/documents/pc_mar_records/$(id); }
    function planActiveOk(d) {
      return d.planId is string && exists(planPath(d.planId))
        && get(planPath(d.planId)).data.status == 'active'
        && get(planPath(d.planId)).data.patientId == d.patientId
        && get(planPath(d.planId)).data.facilityId == d.facilityId;
    }
    function evOrderOk(d) {
      return d.orderId is string && existsAfter(ordPath(d.orderId))
        && getAfter(ordPath(d.orderId)).data.status == 'active'
        && getAfter(ordPath(d.orderId)).data.patientId == d.patientId
        && getAfter(ordPath(d.orderId)).data.facilityId == d.facilityId;
    }

    match /pc_dosing_rules/{ruleId} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'rules.manage')
        && request.resource.data.medicineName is string && request.resource.data.medicineName.size() > 0
        && request.resource.data.source is string && request.resource.data.source.size() >= 3
        && request.resource.data.jurisdiction is string && request.resource.data.jurisdiction.size() >= 2
        && request.resource.data.version is int && request.resource.data.version >= 1
        && request.resource.data.approvalStatus in ['draft', 'approved']
        && (request.resource.data.approvalStatus == 'draft'
            || (request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt == request.time))
        && numOk(request.resource.data, 'dosePerKg', 0, 10000)
        && numOk(request.resource.data, 'minDosePerAdmin', 0, 100000)
        && numOk(request.resource.data, 'maxDosePerAdmin', 0, 100000)
        && numOk(request.resource.data, 'maxDailyDose', 0, 1000000)
        && numOk(request.resource.data, 'minWeightKg', 0, 500)
        && numOk(request.resource.data, 'maxWeightKg', 0, 500)
        && numOk(request.resource.data, 'minAgeMonths', 0, 1500)
        && numOk(request.resource.data, 'maxAgeMonths', 0, 1500);
      allow update: if hasPerm(resource.data.businessId, 'rules.manage')
        && canAccessShop(resource.data.businessId, resource.data.facilityId)
        && pcUpdateStamped()
        && (
          (resource.data.approvalStatus == 'draft' && request.resource.data.approvalStatus == 'approved'
            && request.resource.data.approvedBy == request.auth.uid
            && request.resource.data.approvedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['approvalStatus', 'approvedBy', 'approvedByName', 'approvedAt', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.approvalStatus in ['draft', 'approved'] && request.resource.data.approvalStatus == 'retired'
            && request.resource.data.retiredReason is string && request.resource.data.retiredReason.size() >= 3
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'retiredReason', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    match /pc_treatment_plans/{planId} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'treatment.prescribe')
        && encounterOpenOk(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.prescriberId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() >= 2
        && request.resource.data.careSetting in ['outpatient', 'inpatient', 'home', 'procedure_room']
        && request.resource.data.priority in ['routine', 'urgent'];
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'treatment.prescribe')
        && pcUpdateStamped()
        && resource.data.status == 'active'
        && (
          (request.resource.data.status in ['completed', 'stopped', 'cancelled']
            && request.resource.data.endedBy == request.auth.uid
            && (request.resource.data.status == 'completed'
                || (request.resource.data.get('endReason', null) is string && request.resource.data.endReason.size() >= 3))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'endedAt', 'endedBy', 'endedByName', 'endReason', 'updatedAt', 'updatedBy']))
          ||
          (request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['reviewDate', 'expectedEnd', 'clinicalNotes', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    match /pc_treatment_orders/{orderId} {
      allow read: if childReadOk(resource.data) || dispenserOrderReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'treatment.prescribe')
        && encounterOpenOk(request.resource.data)
        && planActiveOk(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.prescriberId == request.auth.uid
        && request.resource.data.kind in ['medicine', 'procedure']
        && request.resource.data.scheduleType in ['once', 'interval', 'daily', 'fixed', 'weight', 'prn', 'taper', 'custom']
        && request.resource.data.version is int
        && (
          (request.resource.data.kind == 'procedure'
            && request.resource.data.procedureName is string && request.resource.data.procedureName.size() > 0)
          ||
          (request.resource.data.kind == 'medicine'
            && request.resource.data.medicineName is string && request.resource.data.medicineName.size() > 0
            && request.resource.data.doseValue is number && request.resource.data.doseValue > 0)
        )
        && (request.resource.data.scheduleType != 'weight'
            || (request.resource.data.ruleId is string && request.resource.data.weightKg is number
                && request.resource.data.doseConfirmedBy == request.auth.uid));
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'treatment.prescribe')
        && pcUpdateStamped()
        && resource.data.status == 'active'
        && (
          (request.resource.data.status in ['stopped', 'completed']
            && request.resource.data.endedBy == request.auth.uid
            && (request.resource.data.status == 'completed'
                || (request.resource.data.get('endReason', null) is string && request.resource.data.endReason.size() >= 3))
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'endedAt', 'endedBy', 'endedByName', 'endReason', 'updatedAt', 'updatedBy']))
          ||
          (request.resource.data.status == 'superseded'
            && request.resource.data.supersededBy is string
            && request.resource.data.endedBy == request.auth.uid
            && request.resource.data.get('endReason', null) is string && request.resource.data.endReason.size() >= 3
            && existsAfter(ordPath(request.resource.data.supersededBy))
            && getAfter(ordPath(request.resource.data.supersededBy)).data.supersedes == orderId
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'supersededBy', 'endedAt', 'endedBy', 'endedByName', 'endReason', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    match /pc_treatment_events/{evId} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'treatment.prescribe')
        && evOrderOk(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.idKey is string
        && evId == request.resource.data.orderId + '_' + request.resource.data.idKey
        && request.resource.data.plannedAt is number
        && request.resource.data.plannedDay is string;
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && pcUpdateStamped()
        && (
          (resource.data.status in ['pending', 'held']
            && request.resource.data.status in ['administered', 'refused', 'missed', 'not_given', 'held']
            && !(resource.data.status == 'held' && request.resource.data.status == 'held')
            && hasPerm(resource.data.businessId, 'treatment.administer')
            && request.resource.data.lastRecordId is string
            && existsAfter(marPath(request.resource.data.lastRecordId))
            && getAfter(marPath(request.resource.data.lastRecordId)).data.eventId == evId
            && getAfter(marPath(request.resource.data.lastRecordId)).data.outcome == request.resource.data.status
            && getAfter(marPath(request.resource.data.lastRecordId)).data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'lastRecordId', 'actualAt', 'actualDoseValue', 'administeredBy', 'administeredByName', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status == 'held' && request.resource.data.status == 'pending'
            && (hasPerm(resource.data.businessId, 'treatment.administer') || hasPerm(resource.data.businessId, 'treatment.prescribe'))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status in ['pending', 'held'] && request.resource.data.status == 'cancelled'
            && hasPerm(resource.data.businessId, 'treatment.prescribe')
            && request.resource.data.cancelReason is string && request.resource.data.cancelReason.size() >= 3
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelReason', 'updatedAt', 'updatedBy']))
          ||
          (resource.data.status in ['administered', 'refused', 'missed', 'not_given'] && request.resource.data.status == 'pending'
            && hasPerm(resource.data.businessId, 'mar.amend')
            && getAfter(marPath(resource.data.lastRecordId)).data.status == 'entered_in_error'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'updatedBy']))
        );
      allow delete: if false;
    }

    match /pc_mar_records/{marId} {
      allow read: if childReadOk(resource.data);
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'treatment.administer')
        && request.resource.data.status == 'active'
        && request.resource.data.administeredBy == request.auth.uid
        && request.resource.data.outcome in ['administered', 'refused', 'missed', 'held', 'not_given']
        && request.resource.data.actualAt is number
        && (request.resource.data.outcome == 'administered'
            || (request.resource.data.get('omissionReason', null) is string && request.resource.data.omissionReason.size() >= 3))
        && (
          (request.resource.data.get('eventId', null) is string
            && exists(evPath(request.resource.data.eventId))
            && get(evPath(request.resource.data.eventId)).data.status in ['pending', 'held']
            && get(evPath(request.resource.data.eventId)).data.patientId == request.resource.data.patientId
            && get(evPath(request.resource.data.eventId)).data.facilityId == request.resource.data.facilityId)
          ||
          (request.resource.data.get('eventId', null) == null
            && request.resource.data.orderId is string
            && request.resource.data.outcome == 'administered'
            && request.resource.data.get('reason', null) is string && request.resource.data.reason.size() >= 2
            && exists(ordPath(request.resource.data.orderId))
            && get(ordPath(request.resource.data.orderId)).data.scheduleType == 'prn'
            && get(ordPath(request.resource.data.orderId)).data.status == 'active'
            && get(ordPath(request.resource.data.orderId)).data.patientId == request.resource.data.patientId)
        );
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'mar.amend')
        && pcUpdateStamped()
        && resource.data.status == 'active'
        && request.resource.data.status == 'entered_in_error'
        && request.resource.data.errorReason is string && request.resource.data.errorReason.size() >= 3
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'errorReason', 'updatedAt', 'updatedBy']);
      allow delete: if false;
    }

    // =====================================================================================
    // PHASE 5 (v15) — PHARMACY DISPENSING AND CLINICAL GUIDELINES
    // prescriptions / dispense_records / guidelines use the field names fixed by the team Data Contract.
    // Permissions (users/{uid}.perms): dispense.view, dispense.perform, dispense.report, guidelines.manage, guidelines.approve.
    // dispense_records are append-only. A prescription can only move forward, and only in the same commit that writes
    // the matching dispense record. Nothing here can be deleted.
    // KNOWN LIMITS (rules cannot do these): they cannot force drugs/batches quantities to change together with a dispense
    // (audit finding R5: drugs and batches stay writable by every shop member so Sales keeps working), and they cannot
    // filter list queries (guideline drafts are readable by business members; the screen hides them).
    // =====================================================================================
    function rxPath(id) { return /databases/$(database)/documents/prescriptions/$(id); }
    function dspPath(id) { return /databases/$(database)/documents/dispense_records/$(id); }
    function qtyClose(a, b) { return math.abs(a - b) < 0.001; }
    // v16: the dispensing transaction reads documents that do not exist yet (duplicate check). resource is null for those, so the
    // normal read rules (which look at resource.data) would deny it. Only a dispenser may probe for a missing document.
    function dispenserMayProbe() {
      return isSignedIn() && (myProfile().role == 'owner'
        || (myProfile().role == 'operator' && myProfile().active == true && myProfile().get('perms', {}).get('dispense.perform', false) == true));
    }
    function dispenserOrderReadOk(d) {
      return d.kind == 'medicine' && canAccessShop(d.businessId, d.facilityId) && hasPerm(d.businessId, 'dispense.view');
    }
    function rxStatusOk(d) {
      return d.status in ['partially_dispensed', 'completed']
        && ((d.qtyOutstanding <= 0.0001) == (d.status == 'completed'));
    }

    match /prescriptions/{rxId} {
      allow get: if (resource == null && dispenserMayProbe())
        || (resource != null && canAccessShop(resource.data.businessId, resource.data.facilityId) && hasPerm(resource.data.businessId, 'dispense.view'));
      allow list: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'dispense.view');

      // created by the first dispensing: id = the medicine order's id, the order must be an active medicine order of this
      // facility and patient, and the same commit must write the first dispense record for exactly the quantity stated
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'dispense.perform')
        && request.resource.data.id == rxId && request.resource.data.orderId == rxId
        && request.resource.data.patientId is string && request.resource.data.drugId is string
        && request.resource.data.qtyPrescribed is number && request.resource.data.qtyPrescribed > 0
        && request.resource.data.qtyDispensed is number && request.resource.data.qtyDispensed > 0
        && request.resource.data.qtyDispensed <= request.resource.data.qtyPrescribed
        && qtyClose(request.resource.data.qtyOutstanding, request.resource.data.qtyPrescribed - request.resource.data.qtyDispensed)
        && rxStatusOk(request.resource.data)
        && request.resource.data.lastDispensedBy == request.auth.uid
        && request.resource.data.lastRequestId is string
        && exists(ordPath(rxId))
        && get(ordPath(rxId)).data.status == 'active'
        && get(ordPath(rxId)).data.kind == 'medicine'
        && get(ordPath(rxId)).data.businessId == request.resource.data.businessId
        && get(ordPath(rxId)).data.facilityId == request.resource.data.facilityId
        && get(ordPath(rxId)).data.patientId == request.resource.data.patientId
        && existsAfter(dspPath(request.resource.data.lastRequestId + '_0'))
        && getAfter(dspPath(request.resource.data.lastRequestId + '_0')).data.prescriptionId == rxId
        && qtyClose(getAfter(dspPath(request.resource.data.lastRequestId + '_0')).data.groupQty, request.resource.data.qtyDispensed);

      // later dispensing: only the quantity/status fields move, only upwards, and only with a new dispense record in the same commit
      allow update: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'dispense.perform')
        && pcUpdateStamped()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qtyDispensed', 'qtyOutstanding', 'status', 'lastDispensedAt', 'lastDispensedBy', 'lastRequestId', 'updatedBy', 'updatedAt'])
        && request.resource.data.qtyDispensed > resource.data.qtyDispensed
        && request.resource.data.qtyDispensed <= resource.data.qtyPrescribed
        && qtyClose(request.resource.data.qtyOutstanding, resource.data.qtyPrescribed - request.resource.data.qtyDispensed)
        && rxStatusOk(request.resource.data)
        && resource.data.status != 'completed'
        && request.resource.data.lastDispensedBy == request.auth.uid
        && request.resource.data.lastRequestId is string && request.resource.data.lastRequestId != resource.data.lastRequestId
        && existsAfter(dspPath(request.resource.data.lastRequestId + '_0'))
        && getAfter(dspPath(request.resource.data.lastRequestId + '_0')).data.prescriptionId == rxId
        && qtyClose(getAfter(dspPath(request.resource.data.lastRequestId + '_0')).data.groupQty, request.resource.data.qtyDispensed - resource.data.qtyDispensed);

      allow delete: if false;
    }

    match /dispense_records/{dspId} {
      allow get: if (resource == null && dispenserMayProbe())
        || (resource != null && canAccessShop(resource.data.businessId, resource.data.facilityId) && hasPerm(resource.data.businessId, 'dispense.view'));
      allow list: if canAccessShop(resource.data.businessId, resource.data.facilityId)
        && hasPerm(resource.data.businessId, 'dispense.view');

      // one record per batch used; id = requestId_lineNo, so a repeated submission can never create a second record
      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'dispense.perform')
        && request.resource.data.requestId is string && request.resource.data.lineNo is int && request.resource.data.lineNo >= 0
        && dspId == request.resource.data.requestId + '_' + string(request.resource.data.lineNo)
        && request.resource.data.id == dspId
        && request.resource.data.dispensedBy == request.auth.uid
        && request.resource.data.dispensedAt == request.time
        && request.resource.data.isSynced == true
        && request.resource.data.qtyDispensed is number && request.resource.data.qtyDispensed > 0
        && request.resource.data.groupQty is number && request.resource.data.groupQty >= request.resource.data.qtyDispensed
        && request.resource.data.prescriptionId is string && request.resource.data.patientId is string
        && existsAfter(rxPath(request.resource.data.prescriptionId))
        && getAfter(rxPath(request.resource.data.prescriptionId)).data.businessId == request.resource.data.businessId
        && getAfter(rxPath(request.resource.data.prescriptionId)).data.facilityId == request.resource.data.facilityId
        && getAfter(rxPath(request.resource.data.prescriptionId)).data.patientId == request.resource.data.patientId
        && getAfter(rxPath(request.resource.data.prescriptionId)).data.lastRequestId == request.resource.data.requestId;

      allow update, delete: if false;   // append-only
    }

    // ---- Clinical guidelines (reviewed from Developer 2's proposal; nothing is ever deleted) ----
    function glCategoryOk(c) {
      return c in ['general_assessment','common_illnesses','infectious','respiratory','gastrointestinal','paediatric','maternal','ncd','emergency','wound','laboratory','medication_safety','followup_referral'];
    }
    function glReadOk(d) {
      return (d.scope == 'national' && isMemberOfBusiness(d.businessId))
          || (d.scope == 'facility' && canAccessShop(d.businessId, d.facilityId));
    }
    function glPath(id) { return /databases/$(database)/documents/guidelines/$(id); }

    match /guidelines/{glId} {
      allow read: if glReadOk(resource.data);

      allow create: if pcCreateOk(request.resource.data)
        && hasPerm(request.resource.data.businessId, 'guidelines.manage')
        && request.resource.data.scope in ['national', 'facility']
        && request.resource.data.approvalStatus == 'draft'
        && request.resource.data.guidelineKey is string && request.resource.data.version is int && request.resource.data.version >= 1
        && glId == 'gl_' + request.resource.data.guidelineKey + '_v' + string(request.resource.data.version)
        && request.resource.data.id == glId
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 200
        && glCategoryOk(request.resource.data.category)
        && request.resource.data.symptoms is list && request.resource.data.investigations is list
        && request.resource.data.treatment is string && request.resource.data.source is string;

      allow update: if pcUpdateStamped() && canAccessShop(resource.data.businessId, resource.data.facilityId) && (
        // 1. edit a DRAFT (approved text is never edited: a new version is created instead)
        (resource.data.approvalStatus == 'draft' && request.resource.data.approvalStatus == 'draft'
          && hasPerm(resource.data.businessId, 'guidelines.manage')
          && request.resource.data.diff(resource.data).unchangedKeys().hasAll(['id', 'businessId', 'facilityId', 'guidelineKey', 'version', 'scope', 'createdBy', 'createdAt', 'enteredDate'])
          && glCategoryOk(request.resource.data.category))
        ||
        // 2. approve a draft: only the approval fields change, and the source details must be complete
        (resource.data.approvalStatus == 'draft' && request.resource.data.approvalStatus == 'approved'
          && hasPerm(resource.data.businessId, 'guidelines.approve')
          && request.resource.data.approvedBy == request.auth.uid && request.resource.data.approvedAt == request.time
          && request.resource.data.selfApproved == (resource.data.createdBy == request.auth.uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'approvedBy', 'approvedByName', 'approvedAt', 'selfApproved', 'updatedAt', 'updatedBy'])
          && resource.data.sourceTitle.size() > 0 && resource.data.sourceOrg.size() > 0 && resource.data.sourceEdition.size() > 0
          && resource.data.sourceRef.size() > 0 && resource.data.jurisdiction.size() > 0
          && resource.data.effectiveDate.size() == 10 && resource.data.reviewDate.size() == 10 && resource.data.reviewDate >= resource.data.effectiveDate)
        ||
        // 3. replace the previous approved version (the same commit approves a newer version of the same entry)
        (resource.data.approvalStatus == 'approved' && request.resource.data.approvalStatus == 'superseded'
          && hasPerm(resource.data.businessId, 'guidelines.approve')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'supersededBy', 'updatedAt', 'updatedBy'])
          && getAfter(glPath(request.resource.data.supersededBy)).data.approvalStatus == 'approved'
          && getAfter(glPath(request.resource.data.supersededBy)).data.guidelineKey == resource.data.guidelineKey
          && getAfter(glPath(request.resource.data.supersededBy)).data.version > resource.data.version)
        ||
        // 4. retire an approved entry, or discard a draft (a reason is required)
        (resource.data.approvalStatus in ['draft', 'approved'] && request.resource.data.approvalStatus == 'retired'
          && (hasPerm(resource.data.businessId, 'guidelines.approve') || (resource.data.approvalStatus == 'draft' && hasPerm(resource.data.businessId, 'guidelines.manage')))
          && request.resource.data.retiredReason is string && request.resource.data.retiredReason.size() >= 3
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['approvalStatus', 'retiredReason', 'retiredBy', 'retiredByName', 'retiredAt', 'updatedAt', 'updatedBy']))
      );
      allow delete: if false;
    }
  }
}
